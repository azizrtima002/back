# PostgreSQL connection string (local docker-compose defaults below).
# Supabase: copy the "URI" connection string (postgres://...), it is normalized automatically.
DATABASE_URL=postgresql+psycopg://mie:mie@localhost:5432/migration_insights

# First year to ingest when the database is empty.
ETL_START_YEAR=2000

# Local HTTP cache (raw API JSON responses).
CACHE_DIR=./cache
CACHE_TTL_HOURS=24

# Minimum delay between two HTTP calls to the same API (rate-limit courtesy).
REQUEST_MIN_INTERVAL_SECONDS=0.5

# Public GitHub repository shown in the dashboard "About" tab.
GITHUB_REPO_URL=https://github.com/<your-user>/migration-insights
